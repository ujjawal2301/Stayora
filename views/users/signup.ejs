

<% layout("/layouts/boilerplate2") %>

    <div class="auth-container">

        <div class="auth-card">

            <div class="auth-icon">
                <i class="fa-solid fa-user-plus"></i>
            </div>

            <h2>Create Account</h2>

            <p class="auth-subtitle">
                Sign up to start using Stayora
            </p>

            <form action="/signup" method="post" class="needs-validation" novalidate>

                <div class="auth-field">
                    <label for="username">Username</label>

                    <input name="username" id="username" type="text" placeholder="Choose a username" required>

                    <div class="valid-feedback">
                        Looks Good!
                    </div>
                </div>


                <div class="auth-field">
                    <label for="email">Email</label>

                    <input name="email" id="email" type="email" placeholder="Enter your email" required>
                </div>


                <div class="auth-field">
                    <label for="password">Password</label>
                    <div class="password-wrapper">
                        <input name="password" id="password" type="password" placeholder="Create a password" required>
                    </div>
                </div>


                <button type="submit" class="auth-btn">
                    <i class="fa-solid fa-user-plus"></i>
                    Sign Up
                </button>

            </form>


            <p class="auth-footer">
                Already have an account?
                <a href="/login">Login</a>
            </p>

        </div>

    </div>