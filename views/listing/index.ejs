<% layout("/layouts/boilerplate") %>

    <div id="filters">
        <button class="filter-arrow filter-left" type="button">
            <i class="fa-solid fa-chevron-left"></i>
        </button>
        <div class="filter-scroll">
            <div class="filter <%= selectedCategory === 'Rooms' ? 'active-category' : ''%> ">
                <a href="/listing?category=Rooms">
                    <div><i class="fa-solid fa-hotel"></i></div>
                    <p>Rooms</p>
                </a>
            </div>
            <div class="filter <%= selectedCategory === 'Iconic cities' ? 'active-category' : ''%>">
                <a href="/listing?category=Iconic%20cities">
                    <div><i class="fa-solid fa-mountain-city"></i></div>
                    <p>Iconic Cities</p>
                </a>
            </div>
            <div class="filter <%= selectedCategory === 'Mountain' ? 'active-category' : ''%>">
                <a href="/listing?category=Mountain">
                    <div><i class="fa-solid fa-mountain"></i></div>
                    <p>Mountain</p>
                </a>
            </div>
            <div class="filter <%= selectedCategory === 'Castle' ? 'active-category' : ''%>">
                <a href="/listing?category=Castle">
                    <div><i class="fa-brands fa-fort-awesome"></i></div>
                    <p>Castle</p>
                </a>

            </div>
            <div class="filter <%= selectedCategory === 'Amazing pool' ? 'active-category' : ''%>">
                <a href="/listing?category=Amazing%20pool">
                    <div><i class="fa-solid fa-person-swimming"></i></div>
                    <p>Amazing Pool</p>
                </a>

            </div>
            <div class="filter <%= selectedCategory === 'Camping' ? 'active-category' : ''%>">
                <a href="/listing?category=Camping">
                    <div><i class="fa-solid fa-campground"></i></div>
                    <p>Camping</p>
                </a>

            </div>
            <div class="filter <%= selectedCategory === 'Farms' ? 'active-category' : ''%>">
                <a href="/listing?category=Farms">
                    <div><i class="fa-solid fa-cow"></i></div>
                    <p>Farms</p>
                </a>
            </div>
            <div class="filter <%= selectedCategory === 'Arctic' ? 'active-category' : ''%>">
                <a href="/listing?category=Arctic">
                    <div><i class="fa-solid fa-snowflake"></i></div>
                    <p>Arctic</p>
                </a>
            </div>
            <div class="filter <%= selectedCategory === 'Beach' ? 'active-category' : ''%>">
                <a href="/listing?category=Beach">
                    <div><i class="fa-solid fa-umbrella-beach"></i></div>
                    <p>Beach</p>
                </a>
            </div>
            <div class="filter <%= selectedCategory === 'Creative' ? 'active-category' : ''%>">
                <a href="/listing?category=Creative">
                    <div><i class="fa-solid fa-palette"></i></div>
                    <p>Creative</p>
                </a>
            </div>
            <div class="filter <%= selectedCategory === 'Shrine' ? 'active-category' : ''%>">
                <a href="/listing?category=Shrine">
                    <div><i class="fa-solid fa-torii-gate"></i></div>
                    <p>Shrine</p>
                </a>
            </div>
            <div class="filter <%= selectedCategory === 'Ski in' ? 'active-category' : ''%>">
                <a href="/listing?category=Ski%20in">
                    <div><i class="fa-solid fa-person-skiing"></i></div>
                    <p>Ski In</p>
                </a>
            </div>
            <div class="filter <%= selectedCategory === 'Tree house' ? 'active-category' : ''%>">
                <a href="/listing?category=Tree%20house">
                    <div><i class="fa-solid fa-tree-city"></i></div>
                    <p>Tree House</p>
                </a>
            </div>
        </div>
        <button class="filter-arrow filter-right" type="button">
            <i class="fa-solid fa-chevron-right"></i>
        </button>
        <div class="tax-toggle">
            <div class="form-check-reverse form-switch cursor">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Default switch checkbox input</label>
            </div>
        </div>
    </div>

    <% if(allListing.length===0) { %>
        <div class="text-center mt-5">
            <h3>No Listings Found</h3>
            <p>Sorry, we couldn't find any listings for this location.</p>
        </div>
        <% } else { %>
            <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
                <% for(let listing of allListing) { %>
                    <a href="/listing/<%= listing._id %>" class="listing-link">
                        <div class="card col listing-card">
                            <img src="<%= listing.image.url %>" class="card-img-top" alt="listing-image"
                                style="height: 20rem;">
                            <div class="card-img-overlay"></div>
                            <div class="card-body">
                                <p class="card-text">
                                    <b>
                                        <%= listing.title %>
                                    </b><br>
                                    &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                                        <i class="tax-info">&nbsp; +18% GST</i>
                                </p>
                            </div>
                        </div>
                    </a>
                    <% } %>
            </div>
            <% } %>